{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.2",
      "variant": "high"
    },
    "prometheus": {
      "model": "openai/gpt-5.2",
      "variant": "high",
      "description": "Strategic planner using high-IQ models"
    },
    "oracle": {
      "model": "openai/gpt-4o",
      "variant": "medium",
      "description": "Architecture advisor using balanced reasoning models"
    },
    "explore": {
      "model": "openai/gpt-4o-mini",
      "description": "Fast grep/search using cost-efficient models"
    }
  },
  "categories": {
    "quick": {
      "model": "openai/gpt-4o-mini",
      "temperature": 0.3,
      "description": "Trivial tasks execution using weak models"
    },
    "unspecified-low": {
      "model": "openai/gpt-4o",
      "description": "Standard task reasoning using medium models"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.1-codex",
      "variant": "high",
      "description": "Complex implementation using strong models"
    },
    "ultrabrain": {
      "model": "openai/gpt-4o",
      "variant": "medium",
      "description": "Deep logic analysis using medium-high models"
    }
  },
  "mcp": {
    "drawio": {
      "type": "local",
      "command": ["npx", "@next-ai-drawio/mcp-server@latest"],
      "enabled": true
    }
  },
  "sisyphus_agent": {
    "planner_enabled": true,
    "replace_plan": true
  },
  "background_task": {
    "defaultConcurrency": 5,
    "modelConcurrency": {
      "openai/gpt-5.2": 2
    }
  }
}
