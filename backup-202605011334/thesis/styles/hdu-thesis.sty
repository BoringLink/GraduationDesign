\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/hdu-thesis}[2026/04/06 HDU thesis helper]

\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\RequirePackage{geometry}
\RequirePackage{setspace}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{graphicx}
\RequirePackage{caption}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{enumitem}
\RequirePackage{gbt7714}
\RequirePackage{hyperref}
\RequirePackage{xurl}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{fancyvrb}
\RequirePackage{float}
\RequirePackage{pdflscape}
\RequirePackage{bookmark}
\RequirePackage{etoolbox}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,fit,calc,matrix,shadows}

\geometry{a4paper,left=3cm,right=2cm,top=3cm,bottom=2cm,bindingoffset=1cm,headheight=12pt,headsep=0.58cm,footskip=1cm}
\setlength{\baselineskip}{20pt}
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\emergencystretch=2em
\hypersetup{hidelinks,pdfauthor=\ThesisAuthor,pdftitle=\ThesisTitleCn}

\defaultfontfeatures{Ligatures=TeX}
\setmainfont{Times New Roman}
\setsansfont{Arial Unicode MS}
\setmonofont{Menlo}

\IfFontExistsTF{Songti SC}
  {\setCJKmainfont{Songti SC}}
  {\setCJKmainfont{Songti.ttc}}
\IfFontExistsTF{Songti SC}
  {\setCJKfamilyfont{song}{Songti SC}}
  {\setCJKfamilyfont{song}{Songti.ttc}}
\IfFontExistsTF{Heiti SC}
  {\setCJKsansfont{Heiti SC}}
  {\setCJKsansfont{Songti SC}}
\IfFontExistsTF{Heiti SC}
  {\setCJKfamilyfont{hei}{Heiti SC}}
  {\setCJKfamilyfont{hei}{Songti SC}}
\IfFontExistsTF{PingFang SC}
  {\setCJKmonofont{PingFang SC}}
  {\setCJKmonofont{Songti SC}}
\IfFontExistsTF{Kaiti SC}
  {\setCJKfamilyfont{kai}{Kaiti SC}}
  {\IfFontExistsTF{Kaiti TC}
    {\setCJKfamilyfont{kai}{Kaiti TC}}
    {\setCJKfamilyfont{kai}{Noto Sans Kaithi}}}

\newcommand{\kai}{\CJKfamily{kai}}
\newcommand{\song}{\CJKfamily{song}}
\newcommand{\hei}{\CJKfamily{hei}}

\ctexset{
  chapter={
    format={\centering\hei\zihao{3}},
    name={,},
    number={\arabic{chapter}},
    tocline={\numberline{\thechapter\hspace{.3em}}#2},
    beforeskip={18pt},
    afterskip={18pt}
  },
  section={
    format=\hei\zihao{-3},
    number={\thechapter.\arabic{section}},
    beforeskip=12pt,
    afterskip=8pt
  },
  subsection={
    format=\hei\zihao{4},
    number={\thechapter.\arabic{section}.\arabic{subsection}},
    beforeskip=8pt,
    afterskip=6pt
  }
}

% 正文页眉页脚：页眉宋体五号居中，页脚Times New Roman五号“-n-”格式
\fancypagestyle{mainmatterstyle}{%
  \fancyhf{}%
  \fancyhead[C]{\zihao{-5}\song 杭州电子科技大学继续教育学院本科毕业设计（论文）}%
  \fancyfoot[C]{\zihao{-5}\fontspec{Times New Roman}-\arabic{page}-}%
  \renewcommand{\headrulewidth}{0.4pt}%
}
% 前言页眉页脚：页脚罗马数字居中，无页眉
\fancypagestyle{frontmatterstyle}{%
  \fancyhf{}%
  \fancyfoot[C]{\zihao{-5}\fontspec{Times New Roman}\Roman{page}}%
  \renewcommand{\headrulewidth}{0pt}%
}
\pagestyle{mainmatterstyle}

\DeclareCaptionFont{timesnr}{\fontspec{Times New Roman}\fontsize{10.5pt}{20pt}\selectfont}
\DeclareCaptionFont{songti}{\song\fontsize{10.5pt}{20pt}\selectfont}
\captionsetup{
  labelsep=quad,
  justification=centering,
  position=below,
  labelfont={timesnr,bf},
  textfont={songti,bf}
}
\renewcommand{\thefigure}{\arabic{chapter}-\arabic{figure}}
\renewcommand{\thetable}{\arabic{chapter}-\arabic{table}}
\renewcommand{\theequation}{\arabic{chapter}-\arabic{equation}}
\renewcommand{\contentsname}{\hfill\hei\zihao{3}目\quad 录\hfill}
\AtBeginDocument{\setcounter{tocdepth}{1}}
\Urlmuskip=0mu plus 2mu

\renewcommand{\labelenumi}{(\arabic{enumi})}
\renewcommand{\labelenumii}{(\arabic{enumii})}
\setlist[enumerate]{leftmargin=2.2em}
\setlist[itemize]{leftmargin=2.2em}
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}%
  \setlength{\parskip}{0pt}%
}

\DefineVerbatimEnvironment{CodeBlock}{Verbatim}{
  fontsize=\small,
  frame=single,
  xleftmargin=1em,
  xrightmargin=1em
}

\newcommand{\mermaidplaceholder}[2]{
  \begin{figure}[H]
    \centering
    \fbox{
      \parbox{0.88\textwidth}{
        \vspace{1em}
        \centering
        \textbf{图示占位}\\[0.5em]
        #2
        \vspace{1em}
      }
    }
    \caption{#1}
  \end{figure}
}

