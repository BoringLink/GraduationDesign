\tikzset{
  hdubox/.style={
    draw=xaiBorder,
    rounded corners=3.2pt,
    align=center,
    font=\footnotesize\color{xaiText},
    inner sep=4.5pt,
    fill=xaiCard,
    line width=0.6pt,
    drop shadow={opacity=0.12, shadow xshift=0.8pt, shadow yshift=-0.8pt}
  },
  hduarrow/.style={->, line width=0.8pt, >=Latex, draw=xaiAccent},
  xaiLabel/.style={font=\tiny\color{xaiMuted}, fill=white, inner sep=1.1pt, rounded corners=1.4pt, draw=xaiBorder, line width=0.4pt}
}

