\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/hdu-thesis}[2026/04/06 HDU thesis helper]

\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\RequirePackage{geometry}
\RequirePackage{setspace}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage{fancyhdr}
\RequirePackage{graphicx}
\RequirePackage{caption}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{enumitem}
\RequirePackage{hyperref}
\RequirePackage{xurl}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{fancyvrb}
\RequirePackage{float}
\RequirePackage{pdflscape}
\RequirePackage{bookmark}
\RequirePackage{etoolbox}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,fit,calc,matrix,shadows}

\geometry{a4paper,left=3cm,right=2.5cm,top=2.8cm,bottom=2.6cm,headheight=15pt,headsep=0.8cm}
\setstretch{1.35}
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\emergencystretch=2em
\hypersetup{hidelinks,pdfauthor=\ThesisAuthor,pdftitle=\ThesisTitleCn}

\defaultfontfeatures{Ligatures=TeX}
\setmainfont{Times New Roman}
\setsansfont{Arial Unicode MS}
\setmonofont{Menlo}

\IfFontExistsTF{Songti SC}
  {\setCJKmainfont{Songti SC}}
  {\setCJKmainfont{Songti.ttc}}
\IfFontExistsTF{Heiti SC}
  {\setCJKsansfont{Heiti SC}}
  {\setCJKsansfont{Songti SC}}
\IfFontExistsTF{PingFang SC}
  {\setCJKmonofont{PingFang SC}}
  {\setCJKmonofont{Songti SC}}
\IfFontExistsTF{Kaiti SC}
  {\setCJKfamilyfont{kai}{Kaiti SC}}
  {\IfFontExistsTF{Kaiti TC}
    {\setCJKfamilyfont{kai}{Kaiti TC}}
    {\setCJKfamilyfont{kai}{Noto Sans Kaithi}}}

\newcommand{\kai}{\CJKfamily{kai}}
\newcommand{\song}{\CJKfamily{song}}
\newcommand{\hei}{\CJKfamily{hei}}

\ctexset{
  chapter={
    format=\centering\bfseries\zihao{3},
    name={,},
    number=\arabic{chapter},
    beforeskip=18pt,
    afterskip=18pt
  },
  section={
    format=\bfseries\zihao{-3},
    number=\arabic{chapter}.\arabic{section},
    beforeskip=12pt,
    afterskip=8pt
  },
  subsection={
    format=\bfseries\zihao{4},
    number=\arabic{chapter}.\arabic{section}.\arabic{subsection},
    beforeskip=8pt,
    afterskip=6pt
  }
}

\titlecontents{chapter}[0em]{\bfseries}{\contentslabel{2.3em}}{}{\titlerule*[0.8pc]{.}\contentspage}
\titlecontents{section}[2em]{}{\contentslabel{2.8em}}{}{\titlerule*[0.8pc]{.}\contentspage}
\titlecontents{subsection}[4.6em]{}{\contentslabel{3.5em}}{}{\titlerule*[0.8pc]{.}\contentspage}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\zihao{-5}\ThesisTitleCn}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}

\captionsetup{font={small},labelsep=space}
\renewcommand{\contentsname}{目\quad 录}
\Urlmuskip=0mu plus 2mu

\setlist[enumerate]{leftmargin=2.2em}
\setlist[itemize]{leftmargin=2.2em}
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}%
  \setlength{\parskip}{0pt}%
}

\DefineVerbatimEnvironment{CodeBlock}{Verbatim}{
  fontsize=\small,
  frame=single,
  xleftmargin=1em,
  xrightmargin=1em
}

\newcommand{\mermaidplaceholder}[2]{
  \begin{figure}[H]
    \centering
    \fbox{
      \parbox{0.88\textwidth}{
        \vspace{1em}
        \centering
        \textbf{图示占位}\\[0.5em]
        #2
        \vspace{1em}
      }
    }
    \caption{#1}
  \end{figure}
}

\definecolor{xaiBg}{HTML}{F6F8FF}
\definecolor{xaiCard}{HTML}{FFFFFF}
\definecolor{xaiBorder}{HTML}{DCE4F2}
\definecolor{xaiAccent}{HTML}{6B7CFF}
\definecolor{xaiAccent2}{HTML}{4EA9F7}
\definecolor{xaiText}{HTML}{1F2A44}
\definecolor{xaiMuted}{HTML}{6B7895}

% 上标样式的文献引用命令 - 正确使用 text superscript
\DeclareRobustCommand{\cite}[1]{\textsuperscript{#1}}

\tikzset{
  hdubox/.style={
    draw=xaiBorder,
    rounded corners=3.2pt,
    align=center,
    font=\footnotesize\color{xaiText},
    inner sep=4.5pt,
    fill=xaiCard,
    line width=0.6pt,
    drop shadow={opacity=0.12, shadow xshift=0.8pt, shadow yshift=-0.8pt}
  },
  hduarrow/.style={->, line width=0.8pt, >=Latex, draw=xaiAccent},
  xaiLabel/.style={font=\tiny\color{xaiMuted}, fill=white, inner sep=1.1pt, rounded corners=1.4pt, draw=xaiBorder, line width=0.4pt}
}

\newcommand{\tikzTitleFont}{\normalsize}
